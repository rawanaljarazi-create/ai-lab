{
  "installCommand": "npm install",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/aetherwell", "destination": "/aetherwell/index.html" },
    { "source": "/aetherwell/", "destination": "/aetherwell/index.html" },
    { "source": "/squishy", "destination": "/squishy/index.html" },
    { "source": "/squishy/", "destination": "/squishy/index.html" },
    { "source": "/flappy", "destination": "/flappy/index.html" },
    { "source": "/flappy/", "destination": "/flappy/index.html" },
    { "source": "/typing", "destination": "/typing/index.html" },
    { "source": "/typing/", "destination": "/typing/index.html" },
    { "source": "/ios16", "destination": "/ios16/index.html" },
    { "source": "/ios16/", "destination": "/ios16/index.html" }
  ]
}
